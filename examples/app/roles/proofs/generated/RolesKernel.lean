  Result (core.result.Result ((alloc.vec.Vec Doc) × Reply) Error)
  := do
  let o ← roles s actor.user
  match o with
  | none => ok (core.result.Result.Err Error.TooLarge)
  | some rs =>
    match cmd with
    | Command.Get id =>
      let o1 ← find_doc s.docs id
      match o1 with
      | none => ok (core.result.Result.Err Error.NotFound)
      | some d =>
        let b ← may s.readers rs d.path
        if b
        then ok (core.result.Result.Ok (alloc.vec.Vec.new Doc, Reply.Doc d))
        else ok (core.result.Result.Err Error.Forbidden)
    | Command.Put id path body =>
      let p ← h5i_app_std.bytes.trim path
      let b ← may s.writers rs p
      if b
      then
        let v ← alloc.vec.CloneVec.clone core.clone.CloneU8 body
        let ws ←
          alloc.vec.Vec.push (alloc.vec.Vec.new Doc)
            ({ id, path := p, body := v } : Doc)
        ok (core.result.Result.Ok (ws, Reply.Done))
      else ok (core.result.Result.Err Error.Forbidden)
    | Command.List =>
      let v ← readable s.readers rs s.docs
      ok (core.result.Result.Ok (alloc.vec.Vec.new Doc, Reply.Docs v))

