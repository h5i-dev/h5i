/-- [inbox_kernel::send]:
    Source: 'examples/app/tutorials/inbox/kernel/src/lib.rs', lines 156:0-183:1 -/
def send
  (user : Std.U64) (s : Snapshot) («to» : Std.U64)
  (text : alloc.vec.Vec Std.U8) :
  Result (core.result.Result ((alloc.vec.Vec Write) × Reply) Error)
  := do
  let b ← text_ok text
  if b
  then
    let b1 ← is_blocked s.blocks «to» user
    if b1
    then ok (core.result.Result.Err Error.Blocked)
    else
      let o ← last_seq s.messages user «to»
      match o with
      | none =>
        let v ← alloc.vec.CloneVec.clone core.clone.CloneU8 text
        let v1 ←
          one (Write.PutMessage
            {
              sender := user,
              recipient := «to»,
              seq := 0#u64,
              text := v,
              read := false,
              sender_deleted := false,
              recipient_deleted := false
            })
        ok (core.result.Result.Ok (v1, Reply.Sent 0#u64))
      | some k =>
        if k = core.num.U64.MAX
        then ok (core.result.Result.Err Error.Overflow)
        else
          let seq ← k + 1#u64
          let v ← alloc.vec.CloneVec.clone core.clone.CloneU8 text
          let v1 ←
            one (Write.PutMessage
              {
                sender := user,
                recipient := «to»,
                seq,
                text := v,
                read := false,
                sender_deleted := false,
                recipient_deleted := false
              })
          ok (core.result.Result.Ok (v1, Reply.Sent seq))
  else ok (core.result.Result.Err Error.BadText)

/-- [inbox_kernel::mark_read]:
    Source: 'examples/app/tutorials/inbox/kernel/src/lib.rs', lines 185:0-196:1 -/
def mark_read
  (user : Std.U64) (s : Snapshot) («from» : Std.U64) (seq : Std.U64) :
  Result (core.result.Result ((alloc.vec.Vec Write) × Reply) Error)
  := do
  let o ← find_message s.messages «from» user seq
  match o with
  | none => ok (core.result.Result.Err Error.NotFound)
  | some m =>
    if m.recipient_deleted
    then ok (core.result.Result.Err Error.NotFound)
    else
      let v ← one (Write.PutMessage { m with read := true })
      ok (core.result.Result.Ok (v, Reply.Done))

/-- [inbox_kernel::delete]:
    Source: 'examples/app/tutorials/inbox/kernel/src/lib.rs', lines 198:0-217:1 -/
def delete
  (user : Std.U64) (s : Snapshot) («from» : Std.U64) («to» : Std.U64)
  (seq : Std.U64) :
  Result (core.result.Result ((alloc.vec.Vec Write) × Reply) Error)
  := do
  if «from» != user
  then
    if «to» != user
    then ok (core.result.Result.Err Error.NotFound)
    else
      let o ← find_message s.messages «from» «to» seq
      match o with
      | none => ok (core.result.Result.Err Error.NotFound)
      | some m =>
        let (m1, sender_deleted) ←
          if «from» = user
          then ok (m, true)
          else ok (m, m.sender_deleted)
        let (m2, recipient_deleted) ←
          if «to» = user
          then ok (m1, true)
          else ok (m1, m1.recipient_deleted)
        if sender_deleted = m2.sender_deleted
        then
          if recipient_deleted = m2.recipient_deleted
          then ok (core.result.Result.Err Error.NotFound)
          else
            let v ←
              one (Write.PutMessage
                { m2 with sender_deleted, recipient_deleted })
            ok (core.result.Result.Ok (v, Reply.Done))
        else
          let v ←
            one (Write.PutMessage
              { m2 with sender_deleted, recipient_deleted })
          ok (core.result.Result.Ok (v, Reply.Done))
  else
    let o ← find_message s.messages «from» «to» seq
    match o with
    | none => ok (core.result.Result.Err Error.NotFound)
    | some m =>
      let (m1, sender_deleted) ←
        if «from» = user
        then ok (m, true)
        else ok (m, m.sender_deleted)
      let (m2, recipient_deleted) ←
        if «to» = user
        then ok (m1, true)
        else ok (m1, m1.recipient_deleted)
      if sender_deleted = m2.sender_deleted
      then
        if recipient_deleted = m2.recipient_deleted
        then ok (core.result.Result.Err Error.NotFound)
        else
          let v ←
            one (Write.PutMessage
              { m2 with sender_deleted, recipient_deleted })
          ok (core.result.Result.Ok (v, Reply.Done))
      else
        let v ←
          one (Write.PutMessage { m2 with sender_deleted, recipient_deleted })
        ok (core.result.Result.Ok (v, Reply.Done))

/-- [inbox_kernel::transition]:
    Source: 'examples/app/tutorials/inbox/kernel/src/lib.rs', lines 221:0-232:1
    Visibility: public -/
def transition
  (actor : Principal) (s : Snapshot) (cmd : Command) :
  Result (core.result.Result ((alloc.vec.Vec Write) × Reply) Error)
  := do
  match cmd with
  | Command.Send «to» text => send actor.user s «to» text
  | Command.Inbox =>
    let v ← mailbox s.messages actor.user true
    ok (core.result.Result.Ok (alloc.vec.Vec.new Write, Reply.Messages v))
  | Command.Sent =>
    let v ← mailbox s.messages actor.user false
    ok (core.result.Result.Ok (alloc.vec.Vec.new Write, Reply.Messages v))
  | Command.MarkRead «from» seq => mark_read actor.user s «from» seq
  | Command.Delete «from» «to» seq =>
    delete actor.user s «from» «to» seq
  | Command.Block u =>
    let v ← one (Write.PutBlock { owner := actor.user, sender := u })
    ok (core.result.Result.Ok (v, Reply.Done))
  | Command.Unblock u =>
    let v ← one (Write.DelBlock { owner := actor.user, sender := u })
    ok (core.result.Result.Ok (v, Reply.Done))

end inbox_kernel
