def step
  (actor : Cred) (snap : Snapshot) (cmd : Command) (pre : Bool) :
  Result (core.result.Result ((alloc.vec.Vec Write) × Reply) Error)
  := do
  match cmd with
  | Command.Issue secret perms =>
    match actor with
    | Cred.Admin =>
      let b ← taken snap secret
      if b
      then ok (core.result.Result.Err Error.Taken)
      else
        let v ← alloc.vec.CloneVec.clone core.clone.CloneU8 secret
        let v1 ← alloc.vec.CloneVec.clone Perm.Insts.CoreCloneClone perms
        let ws ←
          alloc.vec.Vec.push (alloc.vec.Vec.new Write) (Write.PutKey
            { secret := v, perms := v1 })
        ok (core.result.Result.Ok (ws, Reply.Done))
    | Cred.Key _ => ok (core.result.Result.Err Error.NotAdmin)
    | Cred.Session _ => ok (core.result.Result.Err Error.NotAdmin)
  | Command.Revoke secret =>
    match actor with
    | Cred.Admin =>
      let v ← alloc.vec.CloneVec.clone core.clone.CloneU8 secret
      let ws ← alloc.vec.Vec.push (alloc.vec.Vec.new Write) (Write.DelKey v)
      let ws1 ← alloc.vec.Vec.push ws (Write.Revoked v)
      ok (core.result.Result.Ok (ws1, Reply.Done))
    | Cred.Key _ => ok (core.result.Result.Err Error.NotAdmin)
    | Cred.Session _ => ok (core.result.Result.Err Error.NotAdmin)
  | Command.Open =>
    let o ← resolve snap actor pre
    match o with
    | none => ok (core.result.Result.Err Error.NoKey)
    | some k =>
      if snap.next_session = core.num.U64.MAX
      then ok (core.result.Result.Err Error.Full)
      else
        let ws ←
          alloc.vec.Vec.push (alloc.vec.Vec.new Write) (Write.PutSession
            { id := snap.next_session, secret := k.secret, perms := k.perms })
        ok (core.result.Result.Ok (ws, Reply.Opened snap.next_session))
  | Command.Act action =>
    let o ← resolve snap actor pre
    match o with
    | none => ok (core.result.Result.Err Error.NoKey)
    | some k =>
      let s := alloc.vec.Vec.deref k.perms
      let b ← grants s action
      if b
      then
        ok (core.result.Result.Ok (alloc.vec.Vec.new Write, Reply.Acted
          k.secret))
      else ok (core.result.Result.Err Error.Denied)

