def byte_ok (c : Std.U8) : Result Bool := do
  if c >= 97#u8
  then
    if c <= 122#u8
    then ok true
    else
      if c >= 65#u8
      then
        if c <= 90#u8
        then ok true
        else
          if c >= 48#u8
          then if c <= 57#u8
               then ok true
               else ok (c = 45#u8)
          else ok (c = 45#u8)
      else
        if c >= 48#u8
        then if c <= 57#u8
             then ok true
             else ok (c = 45#u8)
        else ok (c = 45#u8)
  else
    if c >= 65#u8
    then
      if c <= 90#u8
      then ok true
      else
        if c >= 48#u8
        then if c <= 57#u8
             then ok true
             else ok (c = 45#u8)
        else ok (c = 45#u8)
    else
