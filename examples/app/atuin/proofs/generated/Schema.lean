/-! Row writes on the encoding match the list operations. -/

@[simp] theorem Record.map_put (x : Record) (l : List Record) :
    upsert (·.take 4) (Record.row x) (l.map Record.row) = (upsert (fun y => (y.user, y.host, y.tag, y.idx)) x l).map Record.row :=
  map_upsert _ _ _ _ _ (fun y => by simp [Record.row])

@[simp] theorem Record.map_del (user : U64) (host : U64) (tag : U64) (idx : U64) (l : List Record) :
    (l.map Record.row).filter (fun r => !decide (r.take 4 = [int user.val, int host.val, int tag.val, int idx.val])) =
      (l.filter (fun y => !decide (y.user = user ∧ y.host = host ∧ y.tag = tag ∧ y.idx = idx))).map Record.row :=
  map_filter_of _ _ _ _ (fun y => by simp [Record.row])

@[simp] theorem Record.map_del_where (col : Nat) (val : Val) (l : List Record) :
    (l.map Record.row).filter (fun r => !decide (r[col]? = some val)) =
      (l.filter (fun y => !decide ((Record.row y)[col]? = some val))).map Record.row := by
  rw [List.filter_map]; rfl

