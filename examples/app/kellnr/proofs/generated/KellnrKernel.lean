/-- [kellnr_kernel::maybe_user]:
    Source: 'examples/app/kellnr/kernel/src/lib.rs', lines 191:0-202:1 -/
def maybe_user
  (s : Snapshot) (p : Principal) (fixed : Bool) :
  Result (Option MaybeUser)
  := do
  let o ← find_user s.users p.user
  match o with
  | none => ok none
  | some u =>
    match p.login with
    | Login.Session =>
      if fixed
      then
        ok (some
          {
            «name» := u.id,
            is_admin := u.is_admin,
            is_read_only := u.is_read_only
          })
      else
        ok (some
          { «name» := u.id, is_admin := u.is_admin, is_read_only := false })
    | Login.Token =>
      ok (some
        {
          «name» := u.id,
          is_admin := u.is_admin,
          is_read_only := u.is_read_only
        })

