/-- [kellnr_kernel::check_download_auth]:
    Source: 'examples/app/kellnr/kernel/src/lib.rs', lines 224:0-246:1 -/
def check_download_auth
  (s : Snapshot) (krate : Std.U64) (p : Principal) :
  Result (core.result.Result Unit Error)
  := do
  let o ← find_crate s.crates krate
  let restricted ←
    match o with
    | none => ok false
    | some k => ok k.restricted
  if restricted
  then
    let o1 ← token_user s p
    match o1 with
    | none => ok (core.result.Result.Err Error.DownloadUnauthorized)
    | some t =>
      if t.is_admin
      then ok (core.result.Result.Ok ())
      else
        let b ← has_pair s.crate_users krate t.name
        if b
        then ok (core.result.Result.Ok ())
        else
          let b1 ← is_crate_group_user s krate t.name
          if b1
          then ok (core.result.Result.Ok ())
          else
            let b2 ← has_pair s.owners krate t.name
            if b2
            then ok (core.result.Result.Ok ())
            else ok (core.result.Result.Err Error.NotCrateUser)
  else ok (core.result.Result.Ok ())

