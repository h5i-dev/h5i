    Visibility: public -/
def read_scope (cmd : Command) : Result Scope := do
  match cmd with
  | Command.CreateProject _ => ok Scope.Counter
  | Command.SetMember project _ _ => ok (Scope.Project project)
  | Command.RemoveMember project _ => ok (Scope.Project project)
  | Command.CreateDocument project _ _ => ok (Scope.Project project)
  | Command.EditDocument doc _ _ => ok (Scope.Document doc)
  | Command.Submit doc => ok (Scope.Document doc)
  | Command.Approve doc => ok (Scope.Document doc)
  | Command.Publish doc => ok (Scope.Document doc)
  | Command.DeleteDocument doc => ok (Scope.Document doc)
  | Command.GetDocument doc => ok (Scope.Document doc)
  | Command.ListDocuments project => ok (Scope.Project project)
  | Command.SetWebhook project _ => ok (Scope.Project project)

/-- [docs_kernel::transition]:
    Source: 'examples/app/docs/kernel/src/lib.rs', lines 368:0-583:1
    Visibility: public -/
def transition
  (actor : Principal) (snap : Snapshot) (cmd : Command) :
  Result (core.result.Result ((alloc.vec.Vec Write) × Reply) Error)
  := do
  match cmd with
  | Command.CreateProject «name» =>
    let r ← fresh_id snap
    match r with
    | core.result.Result.Ok v =>
      let (id, counter) := v
      let ws ←
        alloc.vec.Vec.push (alloc.vec.Vec.new Write) (Write.SetCounter counter)
      let v1 ← alloc.vec.CloneVec.clone core.clone.CloneU8 «name»
      let ws1 ←
        alloc.vec.Vec.push ws (Write.PutProject { id, «name» := v1 })
      let ws2 ←
        alloc.vec.Vec.push ws1 (Write.PutMember
          { project := id, user := actor.user, role := Role.Owner })
      ok (core.result.Result.Ok (ws2, Reply.Created id))
    | core.result.Result.Err e => ok (core.result.Result.Err e)
  | Command.SetMember project target role =>
    let b ← can snap actor.user project Action.Manage
    if b
    then
      let o ← role_of snap.members project target
      let demotes_owner ←
        match o with
        | none => ok false
        | some r =>
          match r with
          | Role.Viewer => ok false
          | Role.Editor => ok false
          | Role.Owner => ok true
      let b1 ←
        core.cmp.PartialEq.ne.trait_default Role.Insts.CoreCmpPartialEqRole
          role Role.Owner
      let demotes_owner1 ← if b1
                             then ok demotes_owner
                             else ok false
      if demotes_owner1
      then
        let i ← count_owners snap.members project
        if i <= 1#u64
        then ok (core.result.Result.Err Error.LastOwner)
        else
          let v ← one (Write.PutMember { project, user := target, role })
          ok (core.result.Result.Ok (v, Reply.Done))
      else
        let v ← one (Write.PutMember { project, user := target, role })
        ok (core.result.Result.Ok (v, Reply.Done))
    else ok (core.result.Result.Err Error.Forbidden)
  | Command.RemoveMember project target =>
    let b ← can snap actor.user project Action.Manage
    if b
    then
      let o ← role_of snap.members project target
      match o with
      | none => ok (core.result.Result.Err Error.NotFound)
      | some r =>
        let b1 ← Role.Insts.CoreCmpPartialEqRole.eq r Role.Owner
        if b1
        then
          let i ← count_owners snap.members project
          if i <= 1#u64
          then ok (core.result.Result.Err Error.LastOwner)
          else
            let v ← one (Write.DelMember project target)
            ok (core.result.Result.Ok (v, Reply.Done))
        else
          let v ← one (Write.DelMember project target)
          ok (core.result.Result.Ok (v, Reply.Done))
    else ok (core.result.Result.Err Error.Forbidden)
  | Command.CreateDocument project title body =>
    let b ← can snap actor.user project Action.Write
    if b
    then
      let r ← fresh_id snap
      match r with
      | core.result.Result.Ok v =>
        let (id, counter) := v
        let v1 ← alloc.vec.CloneVec.clone core.clone.CloneU8 title
        let v2 ← alloc.vec.CloneVec.clone core.clone.CloneU8 body
        let ws ←
          alloc.vec.Vec.push (alloc.vec.Vec.new Write) (Write.SetCounter
            counter)
        let ws1 ←
          alloc.vec.Vec.push ws (Write.PutDocument
            {
              id,
              project,
              author := actor.user,
              title := v1,
              body := v2,
              status := Status.Draft,
              approver := none,
              version := 1#u64
            })
        ok (core.result.Result.Ok (ws1, Reply.Created id))
      | core.result.Result.Err e => ok (core.result.Result.Err e)
    else ok (core.result.Result.Err Error.Forbidden)
  | Command.EditDocument doc body expected_version =>
    let r ← authorized_doc snap actor.user doc Action.Write
    match r with
    | core.result.Result.Ok v =>
      if v.version != expected_version
      then ok (core.result.Result.Err Error.Conflict)
      else
        let b ←
          Status.Insts.CoreCmpPartialEqStatus.eq v.status Status.Published
        if b
        then ok (core.result.Result.Err Error.BadState)
        else
          let r1 ← with_status v Status.Draft none
          match r1 with
          | core.result.Result.Ok v1 =>
            let v2 ← alloc.vec.CloneVec.clone core.clone.CloneU8 body
            let v3 ← one (Write.PutDocument { v1 with body := v2 })
            ok (core.result.Result.Ok (v3, Reply.Version v1.version))
          | core.result.Result.Err e => ok (core.result.Result.Err e)
    | core.result.Result.Err e => ok (core.result.Result.Err e)
  | Command.Submit doc =>
    let r ← authorized_doc snap actor.user doc Action.Write
    match r with
    | core.result.Result.Ok v =>
      let b ←
        core.cmp.PartialEq.ne.trait_default Status.Insts.CoreCmpPartialEqStatus
          v.status Status.Draft
      if b
      then ok (core.result.Result.Err Error.BadState)
      else
        let r1 ← with_status v Status.InReview none
        match r1 with
        | core.result.Result.Ok v1 =>
          let v2 ← one (Write.PutDocument v1)
          ok (core.result.Result.Ok (v2, Reply.Version v1.version))
        | core.result.Result.Err e => ok (core.result.Result.Err e)
    | core.result.Result.Err e => ok (core.result.Result.Err e)
  | Command.Approve doc =>
    let r ← authorized_doc snap actor.user doc Action.Approve
    match r with
    | core.result.Result.Ok v =>
      let b ←
        core.cmp.PartialEq.ne.trait_default Status.Insts.CoreCmpPartialEqStatus
          v.status Status.InReview
      if b
      then ok (core.result.Result.Err Error.BadState)
      else
        if v.author = actor.user
        then ok (core.result.Result.Err Error.SelfApproval)
        else
          let r1 ← with_status v Status.Approved (some actor.user)
          match r1 with
          | core.result.Result.Ok v1 =>
            let v2 ← one (Write.PutDocument v1)
            ok (core.result.Result.Ok (v2, Reply.Version v1.version))
          | core.result.Result.Err e => ok (core.result.Result.Err e)
    | core.result.Result.Err e => ok (core.result.Result.Err e)
  | Command.Publish doc =>
    let r ← authorized_doc snap actor.user doc Action.Write
    match r with
    | core.result.Result.Ok v =>
      let b ←
        core.cmp.PartialEq.ne.trait_default Status.Insts.CoreCmpPartialEqStatus
          v.status Status.Approved
      if b
      then ok (core.result.Result.Err Error.BadState)
      else
        let r1 ← with_status v Status.Published v.approver
        match r1 with
        | core.result.Result.Ok v1 =>
          let o ← webhook_of snap.webhooks v1.project
          let effect ←
            match o with
            | none => ok none
            | some dest =>
              ok (some
                ({
                   dest,
                   project := v1.project,
                   doc := v1.id,
                   version := v1.version
                 } : Effect))
          let ws ← one (Write.PutDocument v1)
          match effect with
          | none => ok (core.result.Result.Ok (ws, Reply.Version v1.version))
          | some eff =>
            let ws1 ← alloc.vec.Vec.push ws (Write.Emit eff)
            ok (core.result.Result.Ok (ws1, Reply.Version v1.version))
        | core.result.Result.Err e => ok (core.result.Result.Err e)
    | core.result.Result.Err e => ok (core.result.Result.Err e)
  | Command.DeleteDocument doc =>
    let r ← authorized_doc snap actor.user doc Action.Manage
    match r with
    | core.result.Result.Ok v =>
      let v1 ← one (Write.DelDocument v.id)
      ok (core.result.Result.Ok (v1, Reply.Done))
    | core.result.Result.Err e => ok (core.result.Result.Err e)
  | Command.GetDocument doc =>
    let r ← authorized_doc snap actor.user doc Action.Read
    match r with
    | core.result.Result.Ok v =>
      ok (core.result.Result.Ok (alloc.vec.Vec.new Write, Reply.Doc v))
    | core.result.Result.Err e => ok (core.result.Result.Err e)
  | Command.ListDocuments project =>
    let b ← can snap actor.user project Action.Read
    if b
    then
      let v ← documents_in snap.documents project
      ok (core.result.Result.Ok (alloc.vec.Vec.new Write, Reply.Docs v))
    else ok (core.result.Result.Err Error.Forbidden)
  | Command.SetWebhook project dest =>
    let b ← can snap actor.user project Action.Manage
    if b
    then
      let w ←
        match dest with
        | none => ok (Write.DelWebhook project)
        | some d => ok (Write.PutWebhook { project, dest := d })
      let v ← one w
      ok (core.result.Result.Ok (v, Reply.Done))
    else ok (core.result.Result.Err Error.Forbidden)

