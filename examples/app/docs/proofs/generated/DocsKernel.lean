    Visibility: public -/
def allows (role : Role) (action : Action) : Result Bool := do
  match role with
  | Role.Viewer =>
    match action with
    | Action.Read => ok true
    | Action.Write => ok false
    | Action.Approve => ok false
    | Action.Manage => ok false
  | Role.Editor =>
    match action with
    | Action.Read => ok true
    | Action.Write => ok true
    | Action.Approve => ok false
    | Action.Manage => ok false
  | Role.Owner => ok true

