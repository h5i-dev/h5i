def fresh_id
  (snap : Snapshot) :
  Result (core.result.Result (Std.U64 × Counter) Error)
  := do
  if snap.counter.next_id = core.num.U64.MAX
  then ok (core.result.Result.Err Error.Overflow)
  else
    let i ← snap.counter.next_id + 1#u64
    ok (core.result.Result.Ok (snap.counter.next_id, { next_id := i }))

/-- [docs_kernel::authorized_doc]:
    Source: 'examples/app/docs/kernel/src/lib.rs', lines 302:0-315:1 -/
def authorized_doc
  (snap : Snapshot) (user : Std.U64) (doc : Std.U64) (action : Action) :
  Result (core.result.Result Document Error)
  := do
  let o ← find_document snap.documents doc
  match o with
  | none => ok (core.result.Result.Err Error.NotFound)
  | some d =>
    let b ← can snap user d.project Action.Read
    if b
    then
      let b1 ← can snap user d.project action
      if b1
      then ok (core.result.Result.Ok d)
      else ok (core.result.Result.Err Error.Forbidden)
    else ok (core.result.Result.Err Error.NotFound)

