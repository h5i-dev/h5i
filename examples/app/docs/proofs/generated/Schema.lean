/-! Row writes on the encoding match the list operations. -/

@[simp] theorem Document.map_put (x : Document) (l : List Document) :
    upsert (·.take 1) (Document.row x) (l.map Document.row) = (upsert (fun y => y.id) x l).map Document.row :=
