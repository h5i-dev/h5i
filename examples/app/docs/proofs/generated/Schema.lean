  · intro r hr; rw [hr, show ((0#usize : Usize) : Nat) = 0 from rfl]
    exact upsert_loop_result (fun y => y.project) x _ 0 (Nat.zero_le _) (by simp)
  · intro j hj; unfold Webhook.put_loop.body; h5i_step

