/-! ## Decoding -/

/-- Steps through a generated `from_row`. -/
macro "row_tac" : tactic => `(tactic| (
  repeat (first
    | (step*; done)
    | (simp_all only [Project.row, Member.row, Document.row, Counter.row, Webhook.row, List.getElem_cons_zero, List.getElem_cons_succ, Nat.zero_add, Nat.reduceAdd, bind_tc_ok, u64_from_val, bytes_from_val, opt_from_val, Role.col_from_val, Status.col_from_val]; step*))
  all_goals simp_all))

theorem Project.from_row_spec (x : Project) (v : alloc.vec.Vec Val) (h : v.val = Project.row x) :
    Project.from_row v ⦃ o => o = some x ⦄ := by
  have hl : v.length = 2 := by simp [alloc.vec.Vec.length, h, Project.row]
  unfold Project.from_row; row_tac

theorem Member.from_row_spec (x : Member) (v : alloc.vec.Vec Val) (h : v.val = Member.row x) :
    Member.from_row v ⦃ o => o = some x ⦄ := by
  have hl : v.length = 3 := by simp [alloc.vec.Vec.length, h, Member.row]
  unfold Member.from_row; row_tac

theorem Document.from_row_spec (x : Document) (v : alloc.vec.Vec Val) (h : v.val = Document.row x) :
    Document.from_row v ⦃ o => o = some x ⦄ := by
  have hl : v.length = 8 := by simp [alloc.vec.Vec.length, h, Document.row]
  unfold Document.from_row; row_tac

