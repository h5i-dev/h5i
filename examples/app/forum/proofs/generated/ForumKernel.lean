/-- [forum_kernel::{impl h5i_app_std::authz::Policy<forum_kernel::Principal, forum_kernel::Snapshot, forum_kernel::Write, forum_kernel::Row> for forum_kernel::Forum}::permits]:
    Source: 'examples/app/forum/kernel/src/lib.rs', lines 299:4-322:5
    Visibility: public -/
def Forum.Insts.H5i_app_stdAuthzPolicyPrincipalSnapshotWriteRow.permits
  (actor : Principal) (s : Snapshot) (w : Write) : Result Bool := do
  match w with
  | Write.PutUser u =>
    let o ← find_user s.users u.user
    match o with
    | none =>
      if u.user = actor.user
      then
        if u.admin
        then let i := alloc.vec.Vec.len s.users
             ok (i = 0#usize)
        else ok true
      else ok false
    | some old =>
      let b ← is_admin s actor.user
      if b
      then
        if u.admin
        then ok true
        else if old.admin
             then other_admin s u.user
             else ok true
      else ok false
  | Write.PutPost p =>
    let o ← find_post s.posts p.id
    match o with
    | none =>
      if p.author = actor.user
      then ok (p.id = s.counter.next_id)
      else ok false
    | some old =>
      if old.author = actor.user
      then ok (p.author = old.author)
      else
        let b ← is_admin s actor.user
        if b
        then ok (p.author = old.author)
        else ok false
  | Write.DelPost id =>
    let o ← find_post s.posts id
    match o with
    | none => ok false
    | some old =>
      if old.author = actor.user
      then ok true
      else is_admin s actor.user
  | Write.SetCounter c =>
    if s.counter.next_id < core.num.U64.MAX
    then let i ← s.counter.next_id + 1#u64
         ok (c.next_id = i)
    else ok false

