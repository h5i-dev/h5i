      else
        ok (core.result.Result.Ok (alloc.vec.Vec.new Write, Reply.Shown
          { text := v, expires := p.expires, burned := false, owned := b1 }))
    | some l =>
      match key with
      | none => ok (core.result.Result.Err Error.NeedPassword)
      | some k =>
