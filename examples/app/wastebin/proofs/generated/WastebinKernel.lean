def transition
  (a : Principal) (s : Snapshot) (cmd : Command) :
  Result (core.result.Result ((alloc.vec.Vec Write) × Reply) Error)
  := do
  match cmd with
  | Command.Create text expires_in burn lock =>
    create a s text expires_in burn lock
  | Command.View slug confirm key => view a s slug confirm key
  | Command.Fetch slug key => fetch a s slug key
  | Command.Delete slug => delete a s slug
  | Command.Purge => purge a.now s

