  intro s w; funext t
  cases w <;> cases_table t <;>
    simp [applyAllW, applyW, upsert, Paste.putA, Paste.table, Paste.keyLen, Paste.delA, Paste.delWhereA, Counter.putA, Counter.table, Counter.keyLen, Counter.row, $ls,*] <;>
    first
      | exact map_filter_of _ _ _ _ (fun y => by simp [Paste.row, Counter.row])
      | (congr 1; exact List.filter_congr (fun y _ => by simp [Paste.row, Counter.row]))))

/-- Every table write is well formed: `schema_ok [sqlA]`. -/
macro "schema_ok" " [" ls:Lean.Parser.Tactic.simpLemma,* "]" : tactic => `(tactic| (
  intro w; cases w <;>
    simp [WriteOk, RowOk, IsRow, Paste.putA, Paste.table, Paste.keyLen, Paste.delA, Paste.delWhereA, Counter.putA, Counter.table, Counter.keyLen, $ls,*]))

