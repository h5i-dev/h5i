/-- [ledger_kernel::open]:
    Source: 'examples/app/ledger/kernel/src/lib.rs', lines 93:0-101:1 -/
def «open»
  (user : Std.U64) (s : Snapshot) :
  Result (core.result.Result ((alloc.vec.Vec Write) × Reply) Error)
  := do
  if s.ledger.next_id = core.num.U64.MAX
  then ok (core.result.Result.Err Error.Overflow)
  else
    let i ← s.ledger.next_id + 1#u64
    let v ←
      two (Write.PutAccount
        { id := s.ledger.next_id, owner := user, balance := 0#u64 })
        (Write.SetLedger { s.ledger with next_id := i })
    ok (core.result.Result.Ok (v, Reply.Created s.ledger.next_id))

/-- [ledger_kernel::deposit]:
    Source: 'examples/app/ledger/kernel/src/lib.rs', lines 103:0-122:1 -/
def deposit
  (user : Std.U64) (s : Snapshot) (id : Std.U64) (amount : Std.U64) :
  Result (core.result.Result ((alloc.vec.Vec Write) × Reply) Error)
  := do
  let o ← find_account s.accounts id
  match o with
  | none => ok (core.result.Result.Err Error.NotFound)
  | some a =>
    if a.owner != user
    then ok (core.result.Result.Err Error.Forbidden)
    else
      let i ← core.num.U64.MAX - amount
      if s.ledger.deposited > i
      then ok (core.result.Result.Err Error.Overflow)
      else
        if a.balance > i
        then ok (core.result.Result.Err Error.Overflow)
        else
          let i1 ← a.balance + amount
          let i2 ← s.ledger.deposited + amount
          let v ←
            two (Write.PutAccount { a with id, balance := i1 })
              (Write.SetLedger { s.ledger with deposited := i2 })
          ok (core.result.Result.Ok (v, Reply.Balance i1))

/-- [ledger_kernel::withdraw]:
    Source: 'examples/app/ledger/kernel/src/lib.rs', lines 124:0-142:1 -/
def withdraw
  (user : Std.U64) (s : Snapshot) (id : Std.U64) (amount : Std.U64) :
  Result (core.result.Result ((alloc.vec.Vec Write) × Reply) Error)
  := do
  let o ← find_account s.accounts id
  match o with
  | none => ok (core.result.Result.Err Error.NotFound)
  | some a =>
    if a.owner != user
    then ok (core.result.Result.Err Error.Forbidden)
    else
      if amount > a.balance
      then ok (core.result.Result.Err Error.Insufficient)
      else
        let i ← core.num.U64.MAX - amount
        if s.ledger.withdrawn > i
        then ok (core.result.Result.Err Error.Overflow)
        else
          let i1 ← a.balance - amount
          let i2 ← s.ledger.withdrawn + amount
          let v ←
            two (Write.PutAccount { a with id, balance := i1 })
              (Write.SetLedger { s.ledger with withdrawn := i2 })
          ok (core.result.Result.Ok (v, Reply.Balance i1))

/-- [ledger_kernel::transfer]:
    Source: 'examples/app/ledger/kernel/src/lib.rs', lines 144:0-171:1 -/
def transfer
  (user : Std.U64) (s : Snapshot) (src : Std.U64) (dst : Std.U64)
  (amount : Std.U64) :
  Result (core.result.Result ((alloc.vec.Vec Write) × Reply) Error)
  := do
  if src = dst
  then ok (core.result.Result.Err Error.SameAccount)
  else
    let o ← find_account s.accounts src
    match o with
    | none => ok (core.result.Result.Err Error.NotFound)
    | some a =>
      if a.owner != user
      then ok (core.result.Result.Err Error.Forbidden)
      else
        if amount > a.balance
        then ok (core.result.Result.Err Error.Insufficient)
        else
          let o1 ← find_account s.accounts dst
          match o1 with
          | none => ok (core.result.Result.Err Error.NotFound)
          | some b =>
            let i ← core.num.U64.MAX - amount
            if b.balance > i
            then ok (core.result.Result.Err Error.Overflow)
            else
              let i1 ← a.balance - amount
              let i2 ← b.balance + amount
              let v ←
                two (Write.PutAccount { a with id := src, balance := i1 })
                  (Write.PutAccount { b with id := dst, balance := i2 })
              ok (core.result.Result.Ok (v, Reply.Balance i1))

/-- [ledger_kernel::transition]:
    Source: 'examples/app/ledger/kernel/src/lib.rs', lines 175:0-183:1
    Visibility: public -/
def transition
  (actor : Principal) (s : Snapshot) (cmd : Command) :
  Result (core.result.Result ((alloc.vec.Vec Write) × Reply) Error)
  := do
  match cmd with
  | Command.Open => «open» actor.user s
  | Command.Deposit account amount => deposit actor.user s account amount
  | Command.Withdraw account amount => withdraw actor.user s account amount
  | Command.Transfer src dst amount => transfer actor.user s src dst amount
  | Command.List =>
    let v ← alloc.vec.CloneVec.clone Account.Insts.CoreCloneClone s.accounts
    ok (core.result.Result.Ok (alloc.vec.Vec.new Write, Reply.Accounts v))

