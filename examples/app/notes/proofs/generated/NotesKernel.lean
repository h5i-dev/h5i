def put_note
  (user : Std.U64) (s : Snapshot) (id : Std.U64) (body : alloc.vec.Vec Std.U8)
  («public» : Bool) :
  Result (core.result.Result ((alloc.vec.Vec Write) × Reply) Error)
  := do
  let b ← text_ok body
  if b
  then
    let o ← policy.notes.find s.notes id
    let owner ← match o with
                  | none => ok user
                  | some old => ok old.owner
    let v ← alloc.vec.CloneVec.clone core.clone.CloneU8 body
    let v1 ← one (Write.PutNote { id, owner, «public», body := v })
    ok (core.result.Result.Ok (v1, Reply.Done))
  else ok (core.result.Result.Err Error.BadText)

