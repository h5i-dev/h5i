def transition
  (actor : Principal) (s : Snapshot) (cmd : Command) :
  Result (core.result.Result ((alloc.vec.Vec Write) × Reply) Error)
  := do
  match cmd with
  | Command.AddMember user admin =>
    let v ← one (Write.PutMember { user, admin })
    ok (core.result.Result.Ok (v, Reply.Done))
  | Command.RemoveMember user => remove_member s user
  | Command.PutNote id body «public» =>
    put_note actor.user s id body «public»
  | Command.DeleteNote id => delete_note s id
  | Command.ReadNote id => read_note s id
  | Command.ListNotes =>
    let v ← alloc.vec.CloneVec.clone Note.Insts.CoreCloneClone s.notes
    ok (core.result.Result.Ok (alloc.vec.Vec.new Write, Reply.Notes v))
  | Command.ListMembers =>
    let v ← alloc.vec.CloneVec.clone Member.Insts.CoreCloneClone s.members
    ok (core.result.Result.Ok (alloc.vec.Vec.new Write, Reply.Members v))

