    let v ← Follow.del s.follows x.follower x.followed
    ok { s with follows := v }
  | Write.PutArticle x =>
    let v ← Article.put s.articles x
    ok { s with articles := v }
  | Write.DelArticle id =>
    let v ← Article.del s.articles id
    ok { s with articles := v }
  | Write.PutTag x => let v ← Tag.put s.tags x
                      ok { s with tags := v }
