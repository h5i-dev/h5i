    User.from_rows rows ⦃ o => ∃ v, o = some v ∧ v.val = l ⦄ := by
  have e : User.from_rows_loop rows (alloc.vec.Vec.new User) true 0#usize =
      loop (fun x => rowsBody User.from_row rows x.1 x.2.1 x.2.2) (alloc.vec.Vec.new User, true, 0#usize) := by
    unfold User.from_rows_loop; congr 1; funext ⟨a, b, c⟩
