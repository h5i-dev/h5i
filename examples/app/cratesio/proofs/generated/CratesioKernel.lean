  | Via.GitHub => ok (core.result.Result.Err Error.Unauthenticated)
  | Via.Cookie sid =>
    let o ← find_session s.sessions sid
    match o with
    | none => ok (core.result.Result.Err Error.Unauthenticated)
    | some ses =>
      if ses.user != p.user
      then ok (core.result.Result.Err Error.Unauthenticated)
      else signed_in s p none
  | Via.Token tid =>
    let o ← find_token s.tokens tid
    match o with
    | none => ok (core.result.Result.Err Error.Unauthenticated)
    | some t =>
      if t.user != p.user
      then ok (core.result.Result.Err Error.Unauthenticated)
      else
        let b ← token_live t p.now
        if b
        then signed_in s p o
        else ok (core.result.Result.Err Error.Unauthenticated)
  | Via.Operator => ok (core.result.Result.Err Error.Unauthenticated)

