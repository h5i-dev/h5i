  (p : Principal) (s : Snapshot) (fixed : Bool) :
  Result (core.result.Result ((alloc.vec.Vec Write) × Reply) Error)
  := do
  match p.via with
  | Via.GitHub =>
    if s.counter.next_session = core.num.U64.MAX
    then ok (core.result.Result.Err Error.Overflow)
    else
      let i ← s.counter.next_session + 1#u64
      let o ← find_user s.users p.user
      match o with
      | none =>
        let ws ←
          alloc.vec.Vec.push (alloc.vec.Vec.new Write) (Write.PutUser
            {
              id := p.user,
              admin := false,
              locked := false,
              lock_until := 0#u64,
              verified := false
            })
        let ws1 ←
          alloc.vec.Vec.push ws (Write.PutSession
            { id := s.counter.next_session, user := p.user })
        let ws2 ←
          alloc.vec.Vec.push ws1 (Write.SetCounter
            { s.counter with next_session := i })
        ok (core.result.Result.Ok (ws2, Reply.SignedIn p.user
          s.counter.next_session))
      | some u =>
        if fixed
        then
          let b ← is_locked u p.now
          if b
          then ok (core.result.Result.Err Error.AccountLocked)
          else
            let v ←
              two (Write.PutSession
                { id := s.counter.next_session, user := p.user })
                (Write.SetCounter { s.counter with next_session := i })
            ok (core.result.Result.Ok (v, Reply.SignedIn p.user
              s.counter.next_session))
        else
          let v ←
            two (Write.PutSession
              { id := s.counter.next_session, user := p.user })
              (Write.SetCounter { s.counter with next_session := i })
          ok (core.result.Result.Ok (v, Reply.SignedIn p.user
            s.counter.next_session))
