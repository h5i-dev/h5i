def operator
  (p : Principal) (s : Snapshot) (user : Std.U64) (admin : Bool)
  (locked : Bool) («until» : Std.U64) (set_admin : Bool) :
  Result (core.result.Result ((alloc.vec.Vec Write) × Reply) Error)
  := do
  match p.via with
  | Via.GitHub => ok (core.result.Result.Err Error.NotOperator)
  | Via.Cookie _ => ok (core.result.Result.Err Error.NotOperator)
  | Via.Token _ => ok (core.result.Result.Err Error.NotOperator)
  | Via.Operator =>
    let o ← find_user s.users user
    match o with
    | none => ok (core.result.Result.Err Error.NotFound)
    | some u =>
      if set_admin
      then
        let v ← one (Write.PutUser { u with admin })
        ok (core.result.Result.Ok (v, Reply.Done))
      else
        let v ←
          one (Write.PutUser { u with locked, lock_until := «until» })
        ok (core.result.Result.Ok (v, Reply.Done))

