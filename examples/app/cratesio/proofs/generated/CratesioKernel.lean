def handle_invite
  (p : Principal) (s : Snapshot) (krate : Std.U64) (accept : Bool) :
  Result (core.result.Result ((alloc.vec.Vec Write) × Reply) Error)
  := do
  let r ← authenticate s p
  match r with
  | core.result.Result.Ok l =>
    let r1 ← check_scope l.token true Endpoint.Unscoped none
    match r1 with
    | core.result.Result.Ok _ =>
      let o ← find_invite s.invites krate l.user.id
      match o with
      | none => ok (core.result.Result.Err Error.NotFound)
      | some i =>
        if accept
        then
          if i.expires <= p.now
          then ok (core.result.Result.Err Error.InviteExpired)
          else
            if l.user.verified
            then
              let v ←
                two (Write.PutOwner
                  { krate, owner := l.user.id, team := false })
                  (Write.DelInvite krate l.user.id)
              ok (core.result.Result.Ok (v, Reply.Done))
            else ok (core.result.Result.Err Error.EmailNotVerified)
        else
          let v ← one (Write.DelInvite krate l.user.id)
          ok (core.result.Result.Ok (v, Reply.Done))
    | core.result.Result.Err e => ok (core.result.Result.Err e)
  | core.result.Result.Err e => ok (core.result.Result.Err e)

/-- [cratesio_kernel::delete_crate]:
    Source: 'examples/app/cratesio/kernel/src/lib.rs', lines 915:0-945:1 -/
def delete_crate
  (p : Principal) (s : Snapshot) (krate : Std.U64) (downloads : Std.U64) :
  Result (core.result.Result ((alloc.vec.Vec Write) × Reply) Error)
  := do
  let r ← authenticate s p
  match r with
  | core.result.Result.Ok l =>
    let r1 ← check_scope l.token false Endpoint.Unscoped (some krate)
    match r1 with
    | core.result.Result.Ok _ =>
      let o ← find_crate s.crates krate
      match o with
      | none => ok (core.result.Result.Err Error.NotFound)
      | some k =>
        let r2 ← rights s.owners krate l.user.id p.teams
        let r3 ← need_full r2
        match r3 with
        | core.result.Result.Ok _ =>
          let age ← age_of k p.now
          let i ← DELETE_WINDOW
          if age > i
          then
            let i1 ← count_owners s.owners krate
            if i1 > 1#usize
            then ok (core.result.Result.Err Error.MultipleOwners)
            else
              let i2 ← max_downloads age
              if downloads > i2
              then ok (core.result.Result.Err Error.TooManyDownloads)
              else
                let b ← has_reverse_dep s.deps krate
                if b
                then ok (core.result.Result.Err Error.HasReverseDeps)
                else
                  let v ← one (Write.DelCrate krate)
                  ok (core.result.Result.Ok (v, Reply.Done))
          else
            let b ← has_reverse_dep s.deps krate
            if b
            then ok (core.result.Result.Err Error.HasReverseDeps)
            else
              let v ← one (Write.DelCrate krate)
              ok (core.result.Result.Ok (v, Reply.Done))
        | core.result.Result.Err e => ok (core.result.Result.Err e)
    | core.result.Result.Err e => ok (core.result.Result.Err e)
  | core.result.Result.Err e => ok (core.result.Result.Err e)

