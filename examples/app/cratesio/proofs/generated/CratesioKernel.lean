def invite_owner
  (p : Principal) (s : Snapshot) (krate : Std.U64) (target : Std.U64) :
  Result (core.result.Result ((alloc.vec.Vec Write) × Reply) Error)
  := do
  let r ← owner_guard p s krate
  match r with
  | core.result.Result.Ok l =>
    let o ← find_user s.users target
    match o with
    | none => ok (core.result.Result.Err Error.NotFound)
    | some _ =>
      let b ← has_owner s.owners krate target false
      if b
      then ok (core.result.Result.Err Error.AlreadyOwner)
      else
        let o1 ← find_invite s.invites krate target
        match o1 with
        | none =>
          let expires ← invite_expiry p.now
          let v ←
            one (Write.PutInvite
              { krate, user := target, inviter := l.user.id, expires })
          ok (core.result.Result.Ok (v, Reply.Done))
        | some i =>
          if i.expires > p.now
          then
            ok (core.result.Result.Ok (alloc.vec.Vec.new Write,
              Reply.AlreadyInvited))
          else
            let expires ← invite_expiry p.now
            let v ←
              one (Write.PutInvite
                { krate, user := target, inviter := l.user.id, expires })
            ok (core.result.Result.Ok (v, Reply.Done))
  | core.result.Result.Err e => ok (core.result.Result.Err e)

