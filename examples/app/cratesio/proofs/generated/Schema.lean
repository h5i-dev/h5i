    dsimp only
    split <;> (try rfl)
    congr 1; funext v; congr 1; funext o; cases o <;> rfl
  have hl : User.from_rows_loop rows (alloc.vec.Vec.new User) true 0#usize ⦃ r => r.2 = true ∧ r.1.val = l ⦄ := by
