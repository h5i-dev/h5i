def Rule.delA (id : U64) : AWrite Val := .del Rule.table [int id.val]
def Rule.delWhereA (col : Nat) (val : Val) : AWrite Val := .delWhere Rule.table col val

@[step] theorem Rule.sql_del_spec (id : U64) : Rule.sql_del id ⦃ w => sqlW w = Rule.delA id ⦄ := by
  unfold Rule.sql_del; step* <;> simp_all [sqlW, Rule.delA, Rule.table, Rule.TABLE] <;> scalar_tac

@[step] theorem Rule.sql_del_where_spec (col : U32) (val : Val) :
    Rule.sql_del_where col val ⦃ w => sqlW w = Rule.delWhereA col.val val ⦄ := by
  unfold Rule.sql_del_where; simp [sqlW, Rule.delWhereA, Rule.table, Rule.TABLE]

/-! Row writes on the encoding match the list operations. -/

@[simp] theorem Rule.map_put (x : Rule) (l : List Rule) :
    upsert (·.take 1) (Rule.row x) (l.map Rule.row) = (upsert (fun y => y.id) x l).map Rule.row :=
  map_upsert _ _ _ _ _ (fun y => by simp [Rule.row])

@[simp] theorem Rule.map_del (id : U64) (l : List Rule) :
    (l.map Rule.row).filter (fun r => !decide (r.take 1 = [int id.val])) =
      (l.filter (fun y => !decide (y.id = id))).map Rule.row :=
  map_filter_of _ _ _ _ (fun y => by simp [Rule.row])

@[simp] theorem Rule.map_del_where (col : Nat) (val : Val) (l : List Rule) :
    (l.map Rule.row).filter (fun r => !decide (r[col]? = some val)) =
      (l.filter (fun y => !decide ((Rule.row y)[col]? = some val))).map Rule.row := by
  rw [List.filter_map]; rfl

/-! ## Decoding -/

/-- Steps through a generated `from_row`. -/
macro "row_tac" : tactic => `(tactic| (
  repeat (first
    | (step*; done)
    | (simp_all only [Bookmark.row, Event.row, Rule.row, List.getElem_cons_zero, List.getElem_cons_succ, Nat.zero_add, Nat.reduceAdd, bind_tc_ok, u64_from_val, bool_from_val, bytes_from_val]; step*))
  all_goals simp_all))

theorem Bookmark.from_row_spec (x : Bookmark) (v : alloc.vec.Vec Val) (h : v.val = Bookmark.row x) :
    Bookmark.from_row v ⦃ o => o = some x ⦄ := by
  have hl : v.length = 3 := by simp [alloc.vec.Vec.length, h, Bookmark.row]
  unfold Bookmark.from_row; row_tac

theorem Event.from_row_spec (x : Event) (v : alloc.vec.Vec Val) (h : v.val = Event.row x) :
    Event.from_row v ⦃ o => o = some x ⦄ := by
  have hl : v.length = 5 := by simp [alloc.vec.Vec.length, h, Event.row]
  unfold Event.from_row; row_tac

theorem Rule.from_row_spec (x : Rule) (v : alloc.vec.Vec Val) (h : v.val = Rule.row x) :
    Rule.from_row v ⦃ o => o = some x ⦄ := by
  have hl : v.length = 7 := by simp [alloc.vec.Vec.length, h, Rule.row]
  unfold Rule.from_row; row_tac

theorem Bookmark.from_rows_spec (rows : alloc.vec.Vec (alloc.vec.Vec Val)) (l : List Bookmark)
    (h : rows.val.map (·.val) = l.map Bookmark.row) :
    Bookmark.from_rows rows ⦃ o => ∃ v, o = some v ∧ v.val = l ⦄ := by
  have e : Bookmark.from_rows_loop rows (alloc.vec.Vec.new Bookmark) true 0#usize =
      loop (fun x => rowsBody Bookmark.from_row rows x.1 x.2.1 x.2.2) (alloc.vec.Vec.new Bookmark, true, 0#usize) := by
    unfold Bookmark.from_rows_loop; congr 1; funext ⟨a, b, c⟩
    simp only []; unfold Bookmark.from_rows_loop.body rowsBody
    dsimp only
    split <;> (try rfl)
    congr 1; funext v; congr 1; funext o; cases o <;> rfl
  have hl : Bookmark.from_rows_loop rows (alloc.vec.Vec.new Bookmark) true 0#usize ⦃ r => r.2 = true ∧ r.1.val = l ⦄ := by
    rw [e]; exact rows_loop Bookmark.from_row Bookmark.row (fun x v hv => Bookmark.from_row_spec x v hv) rows l h
  unfold Bookmark.from_rows
  step with hl
  simp [ok1_post, l_post]

theorem Event.from_rows_spec (rows : alloc.vec.Vec (alloc.vec.Vec Val)) (l : List Event)
    (h : rows.val.map (·.val) = l.map Event.row) :
    Event.from_rows rows ⦃ o => ∃ v, o = some v ∧ v.val = l ⦄ := by
  have e : Event.from_rows_loop rows (alloc.vec.Vec.new Event) true 0#usize =
      loop (fun x => rowsBody Event.from_row rows x.1 x.2.1 x.2.2) (alloc.vec.Vec.new Event, true, 0#usize) := by
    unfold Event.from_rows_loop; congr 1; funext ⟨a, b, c⟩
    simp only []; unfold Event.from_rows_loop.body rowsBody
    dsimp only
    split <;> (try rfl)
    congr 1; funext v; congr 1; funext o; cases o <;> rfl
  have hl : Event.from_rows_loop rows (alloc.vec.Vec.new Event) true 0#usize ⦃ r => r.2 = true ∧ r.1.val = l ⦄ := by
    rw [e]; exact rows_loop Event.from_row Event.row (fun x v hv => Event.from_row_spec x v hv) rows l h
  unfold Event.from_rows
  step with hl
  simp [ok1_post, l_post]

theorem Rule.from_rows_spec (rows : alloc.vec.Vec (alloc.vec.Vec Val)) (l : List Rule)
    (h : rows.val.map (·.val) = l.map Rule.row) :
    Rule.from_rows rows ⦃ o => ∃ v, o = some v ∧ v.val = l ⦄ := by
  have e : Rule.from_rows_loop rows (alloc.vec.Vec.new Rule) true 0#usize =
      loop (fun x => rowsBody Rule.from_row rows x.1 x.2.1 x.2.2) (alloc.vec.Vec.new Rule, true, 0#usize) := by
    unfold Rule.from_rows_loop; congr 1; funext ⟨a, b, c⟩
    simp only []; unfold Rule.from_rows_loop.body rowsBody
    dsimp only
    split <;> (try rfl)
    congr 1; funext v; congr 1; funext o; cases o <;> rfl
  have hl : Rule.from_rows_loop rows (alloc.vec.Vec.new Rule) true 0#usize ⦃ r => r.2 = true ∧ r.1.val = l ⦄ := by
    rw [e]; exact rows_loop Rule.from_row Rule.row (fun x v hv => Rule.from_row_spec x v hv) rows l h
  unfold Rule.from_rows
  step with hl
  simp [ok1_post, l_post]

/-! ## Tables -/

/-- Key length per table. -/
def kl : Nat → Nat
  | 0 => 1
  | 1 => 1
  | 2 => 1
  | _ => 0

@[simp] theorem kl_0 : kl 0 = 1 := rfl
@[simp] theorem kl_1 : kl 1 = 1 := rfl
@[simp] theorem kl_2 : kl 2 = 1 := rfl

/-- `row` encodes a value of table `t`'s row type. -/
def IsRow : Nat → List Val → Prop
  | 0 => fun r => ∃ x : Bookmark, r = Bookmark.row x
  | 1 => fun r => ∃ x : Event, r = Event.row x
  | 2 => fun r => ∃ x : Rule, r = Rule.row x
  | _ => fun _ => False

/-- Split a goal about table `t` into one goal per table. -/
macro "cases_table " t:ident : tactic => `(tactic| rcases $t:ident with _ | _ | _ | $t:ident)

/-- A write's table writes map a state's encoding to the next: `schema_step [enc, sqlA, applyWrite]`. -/
macro "schema_step" " [" ls:Lean.Parser.Tactic.simpLemma,* "]" : tactic => `(tactic| (
  intro s w; funext t
  cases w <;> cases_table t <;>
    simp [applyAllW, applyW, upsert, Bookmark.putA, Bookmark.table, Bookmark.keyLen, Bookmark.delA, Bookmark.delWhereA, Event.putA, Event.table, Event.keyLen, Event.delA, Event.delWhereA, Rule.putA, Rule.table, Rule.keyLen, Rule.delA, Rule.delWhereA, $ls,*] <;>
    first
      | exact map_filter_of _ _ _ _ (fun y => by simp [Bookmark.row, Event.row, Rule.row])
      | (congr 1; exact List.filter_congr (fun y _ => by simp [Bookmark.row, Event.row, Rule.row]))))

/-- Every table write is well formed: `schema_ok [sqlA]`. -/
macro "schema_ok" " [" ls:Lean.Parser.Tactic.simpLemma,* "]" : tactic => `(tactic| (
  intro w; cases w <;>
    simp [WriteOk, RowOk, IsRow, Bookmark.putA, Bookmark.table, Bookmark.keyLen, Bookmark.delA, Bookmark.delWhereA, Event.putA, Event.table, Event.keyLen, Event.delA, Event.delWhereA, Rule.putA, Rule.table, Rule.keyLen, Rule.delA, Rule.delWhereA, $ls,*]))

/-- A fresh tenant's tables: `schema_init [enc, init]`. -/
macro "schema_init" " [" ls:Lean.Parser.Tactic.simpLemma,* "]" : tactic => `(tactic| (
  intro t; cases_table t <;> simp [InitOk, $ls,*]))

/-- A fresh tenant's rows are rows of their tables: `schema_rows [enc, init]`. -/
macro "schema_rows" " [" ls:Lean.Parser.Tactic.simpLemma,* "]" : tactic => `(tactic| (
  intro t r h; cases_table t <;> simp [$ls,*] at h <;> subst h <;> first | rfl))

/-! ## The snapshot -/

/-- A snapshot's rows, table by table. -/
def Snapshot.enc (s : Snapshot) : Tables Val
  | 0 => s.bookmarks.val.map Bookmark.row
  | 1 => s.events.val.map Event.row
  | 2 => s.rules.val.map Rule.row
  | _ => []

/-- A fresh tenant's snapshot. -/
def Snapshot.empty : Snapshot :=
  { bookmarks := alloc.vec.Vec.new Bookmark, events := alloc.vec.Vec.new Event, rules := alloc.vec.Vec.new Rule }

/-- Stored rows, table by table. -/
def Rows.tabs (r : Rows) : Tables Val
  | 0 => r.bookmarks.val.map (·.val)
  | 1 => r.events.val.map (·.val)
  | 2 => r.rules.val.map (·.val)
  | _ => []

theorem Snapshot.clone_eq (s : Snapshot) : Snapshot.Insts.CoreCloneClone.clone s = ok s := by
  simp [Snapshot.Insts.CoreCloneClone.clone,
    vec_clone_eq Bookmark.Insts.CoreCloneClone s.bookmarks Bookmark.clone_eq,
    vec_clone_eq Event.Insts.CoreCloneClone s.events Event.clone_eq,
    vec_clone_eq Rule.Insts.CoreCloneClone s.rules Rule.clone_eq]

/-- `decode` reads back tables `E` up to row order (an empty singleton table reads as its fresh row). -/
theorem decode_spec (r : Rows) (E : Tables Val)
    (hrow : ∀ t, ∀ row ∈ E t, IsRow t row)
    (hnil : ∀ t, 3 ≤ t → E t = [])
    (hR : ∀ t, (Rows.tabs r t).Perm (E t) ∨ (Rows.tabs r t = [] ∧ E t = Snapshot.enc Snapshot.empty t)) :
    decode r ⦃ o => ∃ s, o = some s ∧ ∀ t, (Snapshot.enc s t).Perm (E t) ⦄ := by
  have h0 : (Rows.tabs r 0).Perm (E 0) := keyed_perm (hR 0)
  obtain ⟨l0, e0⟩ := exists_map Bookmark.row (Rows.tabs r 0) (fun row h => hrow 0 row (h0.subset h))
  have h1 : (Rows.tabs r 1).Perm (E 1) := keyed_perm (hR 1)
  obtain ⟨l1, e1⟩ := exists_map Event.row (Rows.tabs r 1) (fun row h => hrow 1 row (h1.subset h))
  have h2 : (Rows.tabs r 2).Perm (E 2) := keyed_perm (hR 2)
  obtain ⟨l2, e2⟩ := exists_map Rule.row (Rows.tabs r 2) (fun row h => hrow 2 row (h2.subset h))
  unfold decode
  step with Bookmark.from_rows_spec r.bookmarks l0 e0 as ⟨ o0, v0, ho0, hv0 ⟩
  subst ho0; dsimp only
  step with Event.from_rows_spec r.events l1 e1 as ⟨ o1, v1, ho1, hv1 ⟩
  subst ho1; dsimp only
  step with Rule.from_rows_spec r.rules l2 e2 as ⟨ o2, v2, ho2, hv2 ⟩
  subst ho2; dsimp only
  refine ⟨_, rfl, fun t => ?_⟩
  match t with
  | 0 => simp only [Snapshot.enc, hv0]; rw [← e0]; exact h0
  | 1 => simp only [Snapshot.enc, hv1]; rw [← e1]; exact h1
  | 2 => simp only [Snapshot.enc, hv2]; rw [← e2]; exact h2
  | t + 3 => simp only [Snapshot.enc, hnil (t + 3) (by omega)]; exact .refl _

/-! ## Partial loads

`Store::load_for` may load each table by one declarative read of a plan
(`schema_load_plan`). `Snapshot.load plan s` is what loading `plan` from the
tables of `s` decodes to (`decode_load`); an app's frame theorem shows
`transition` gives the same result on it as on `s`. Values compare by
classical equality, as everywhere in this file. -/

section PartialLoads
open H5iAppLib.Query

/-- A vector's rows that the plan loads. -/
noncomputable def pickVec {α : Type} (plan : List (Query.Read Val)) (tabs : Tables Val) (t : Nat) (row : α → List Val)
    (v : alloc.vec.Vec α) : alloc.vec.Vec α :=
  .from (pickRows plan tabs t row v.val) ((pickRows_length plan tabs t row v.val).trans v.len_ineq)

/-- What loading `plan` from the tables of `s` decodes to: each table's rows its read keeps, none if the plan
does not read it; a singleton table reads as fresh unless its read keeps its row. -/
noncomputable def Snapshot.load (plan : List (Query.Read Val)) (s : Snapshot) : Snapshot :=
  { bookmarks := pickVec plan (Snapshot.enc s) 0 Bookmark.row s.bookmarks, events := pickVec plan (Snapshot.enc s) 1 Event.row s.events, rules := pickVec plan (Snapshot.enc s) 2 Rule.row s.rules }

@[simp] theorem Snapshot.load_bookmarks (plan : List (Query.Read Val)) (s : Snapshot) :
    (Snapshot.load plan s).bookmarks.val = pickRows plan (Snapshot.enc s) 0 Bookmark.row s.bookmarks.val :=
  alloc.vec.Vec.from_val _ _

@[simp] theorem Snapshot.load_events (plan : List (Query.Read Val)) (s : Snapshot) :
    (Snapshot.load plan s).events.val = pickRows plan (Snapshot.enc s) 1 Event.row s.events.val :=
  alloc.vec.Vec.from_val _ _

@[simp] theorem Snapshot.load_rules (plan : List (Query.Read Val)) (s : Snapshot) :
    (Snapshot.load plan s).rules.val = pickRows plan (Snapshot.enc s) 2 Rule.row s.rules.val :=
  alloc.vec.Vec.from_val _ _


/-- Rows holding, for each table, what `plan` loads from the tables of `s` decode to `Snapshot.load plan s`. -/
theorem decode_load (plan : List (Query.Read Val)) (s : Snapshot) (r : Rows)
    (h : ∀ t, t < 3 → Rows.tabs r t = load plan (Snapshot.enc s) t) :
    decode r = ok (some (Snapshot.load plan s)) := by
  have e0 := h 0 (by omega)
  rw [load_pick plan _ 0 Bookmark.row s.bookmarks.val rfl] at e0
  have e1 := h 1 (by omega)
  rw [load_pick plan _ 1 Event.row s.events.val rfl] at e1
  have e2 := h 2 (by omega)
  rw [load_pick plan _ 2 Rule.row s.rules.val rfl] at e2
  simp only [Rows.tabs] at *
  apply eq_ok_of_spec
  unfold decode
  step with Bookmark.from_rows_spec r.bookmarks _ e0 as ⟨ o0, v0, ho0, hv0 ⟩
  subst ho0; dsimp only
  step with Event.from_rows_spec r.events _ e1 as ⟨ o1, v1, ho1, hv1 ⟩
  subst ho1; dsimp only
  step with Rule.from_rows_spec r.rules _ e2 as ⟨ o2, v2, ho2, hv2 ⟩
  subst ho2; dsimp only
  simp only [WP.spec_ok, Option.some.injEq, Snapshot.load]
  congr 1 <;> apply alloc.vec.Vec.ext <;> simp [pickVec, *]

/-- `IN` a column of a read of table 0, as a test on the snapshot's rows. -/
theorem holds_in_0 (s : Snapshot) (i j : Nat) (p : Query.Pred Val) (w : Query.Window) (r : List Val) :
    (Query.Pred.isIn i 0 p j w).holds (Snapshot.enc s) r =
      match r[i]? with
      | none => false
      | some x => (w.apply ((s.bookmarks.val).filter (fun y => p.holds (Snapshot.enc s) (Bookmark.row y)))).any
          (fun y => decide ((Bookmark.row y)[j]? = some x)) := by
  rw [Query.holds_isIn (tabs := Snapshot.enc s) (i := i) (t := 0) (j := j) (p := p) (w := w) (r := r) (f := Bookmark.row)
    (l := s.bookmarks.val) (h := rfl)]
  cases r[i]? <;> rfl

/-- `IN` a column of a read of table 1, as a test on the snapshot's rows. -/
theorem holds_in_1 (s : Snapshot) (i j : Nat) (p : Query.Pred Val) (w : Query.Window) (r : List Val) :
    (Query.Pred.isIn i 1 p j w).holds (Snapshot.enc s) r =
      match r[i]? with
      | none => false
      | some x => (w.apply ((s.events.val).filter (fun y => p.holds (Snapshot.enc s) (Event.row y)))).any
          (fun y => decide ((Event.row y)[j]? = some x)) := by
  rw [Query.holds_isIn (tabs := Snapshot.enc s) (i := i) (t := 1) (j := j) (p := p) (w := w) (r := r) (f := Event.row)
    (l := s.events.val) (h := rfl)]
  cases r[i]? <;> rfl

/-- `IN` a column of a read of table 2, as a test on the snapshot's rows. -/
theorem holds_in_2 (s : Snapshot) (i j : Nat) (p : Query.Pred Val) (w : Query.Window) (r : List Val) :
    (Query.Pred.isIn i 2 p j w).holds (Snapshot.enc s) r =
      match r[i]? with
      | none => false
      | some x => (w.apply ((s.rules.val).filter (fun y => p.holds (Snapshot.enc s) (Rule.row y)))).any
          (fun y => decide ((Rule.row y)[j]? = some x)) := by
  rw [Query.holds_isIn (tabs := Snapshot.enc s) (i := i) (t := 2) (j := j) (p := p) (w := w) (r := r) (f := Rule.row)
    (l := s.rules.val) (h := rfl)]
  cases r[i]? <;> rfl


end PartialLoads

/-- Rows in a snapshot's keyed tables; a write adds at most one. -/
def Snapshot.size (s : Snapshot) : Nat := s.bookmarks.length + s.events.length + s.rules.length

/-! ## Loading

An app's `Storage.lean` gives an `H5iAppLib.Store.App` numbered like this schema. -/

section Load
variable {St W : Type} (A : App St W Val) (toSt : Snapshot → St)

/-- The app's storage matches this schema. -/
structure Fits : Prop where
  kl : A.kl = kl
  rows : A.IsRow = IsRow
  enc : ∀ s, A.enc (toSt s) = Snapshot.enc s
  init : A.enc A.init = Snapshot.enc Snapshot.empty
  nil : ∀ s t, 3 ≤ t → A.enc s t = []

variable {A toSt}

/-- Loading a served database decodes to the state it holds, up to row order. -/
theorem loaded (hf : Fits A toSt) {db : Db Val} {s : St} (h : A.Served db s) (r : Rows)
    (hl : Lists kl db (Rows.tabs r)) :
    decode r ⦃ o => ∃ snap, o = some snap ∧ A.Equiv (toSt snap) s ⦄ := by
  obtain ⟨-, hrow, hone⟩ := A.served_holds h
  have hR := A.served_lists h _ (by rw [hf.kl]; exact hl)
  rw [hf.rows] at hrow
  rw [hf.kl] at hone
  apply WP.spec_mono (decode_spec r (A.enc s) hrow  (hf.nil s)
    (fun t => by rw [← hf.init]; exact hR t))
  rintro o ⟨snap, rfl, hp⟩
  exact ⟨snap, rfl, fun t => by rw [hf.enc]; exact hp t⟩

end Load

end parallel_kernel.Schema
