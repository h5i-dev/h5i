  := do
  if enabled
  then
    if power < required
    then ok 0#u32
    else
      if members < minimum
      then ok 0#u32
      else
        if members > maximum
        then ok 0#u32
        else
          let b ← glob event pattern
          if b
          then
            let len ← push_rule_loop display 0#usize
            if require_display
            then
              if len = 0#usize
              then ok 0#u32
              else
                let b1 ← contains event display 0#usize len
                if b1
                then ok 1#u32
                else ok 0#u32
            else ok 1#u32
          else ok 0#u32
  else ok 0#u32

end parallel_kernel
