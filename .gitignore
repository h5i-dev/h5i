.h5i/
crates/h5i-browser-light/wpt/results*/
.agents/
skills-lock.json

# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/


# Added by cargo

/target

# The box console frontend (Vite + React + Blueprint), served by `h5i ui`.
# `dist/` is generated by h5i-core's build script and embedded into the binary;
# `tsconfig.tsbuildinfo` is tsc's incremental cache. Neither belongs in git.
/web/node_modules
/web/dist
/web/.vite
/web/tsconfig.tsbuildinfo
/PERSONA.md

# Python bytecode from the WPT harness.
__pycache__/

# WPT sweep output: regenerated by wpt/sweep.sh, large, and a measurement
# rather than a source. The numbers live in ROADMAP.md §B8.
crates/h5i-browser-light/wpt/results/
crates/h5i-browser-light/wpt/results-baseline/
# Scratch output of wpt/gate.sh. The committed artefact is wpt/baseline.json,
# which is small and is the thing CI compares against.
crates/h5i-browser-light/wpt/gate-results/

# Per-machine Claude Code tool permissions. `.local.` means what it says: this
# is one developer's answer to "may this tool run here", not a project fact.
# It was committed once by an over-broad `git add -A` during a review.
.claude/settings.local.json
