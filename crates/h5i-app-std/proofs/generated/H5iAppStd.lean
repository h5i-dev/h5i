/-- [h5i_app_std::time::expired]:
    Source: 'crates/h5i-app-std/src/time.rs', lines 8:0-10:1
    Visibility: public -/
def time.expired
  (exp : Std.U64) (now : Std.U64) (leeway : Std.U64) : Result Bool := do
  if now > leeway
  then let i ← now - leeway
       ok (exp < i)
  else ok false

/-- [h5i_app_std::time::not_yet_valid]:
    Source: 'crates/h5i-app-std/src/time.rs', lines 13:0-15:1
    Visibility: public -/
def time.not_yet_valid
  (nbf : Std.U64) (now : Std.U64) (leeway : Std.U64) : Result Bool := do
  if nbf > leeway
  then let i ← nbf - leeway
       ok (now < i)
  else ok false

/-- [h5i_app_std::time::within]:
    Source: 'crates/h5i-app-std/src/time.rs', lines 18:0-20:1
    Visibility: public -/
def time.within
  (start : Std.U64) (now : Std.U64) (ttl : Std.U64) : Result Bool := do
  if now < start
  then ok true
  else let i ← now - start
       ok (i < ttl)

/-- [h5i_app_std::time::secs_ceil]:
    Source: 'crates/h5i-app-std/src/time.rs', lines 23:0-26:1
    Visibility: public -/
def time.secs_ceil (micros : Std.U64) : Result Std.U64 := do
  let s ← micros / 1000000#u64
  let i ← micros % 1000000#u64
  if i = 0#u64
  then ok s
  else s + 1#u64

