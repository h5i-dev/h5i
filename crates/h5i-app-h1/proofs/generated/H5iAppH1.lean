    then ok (true, lim.max_head)
    else let n1 := Slice.len buf
         ok (false, n1)
  let j ← line_end buf 0#usize n
  let t ← line_term buf j n
  if t = 1#u8
  then
    if full
    then ok (HeadResult.Reject URI_TOO_LONG)
    else ok HeadResult.Incomplete
  else
    if t = 2#u8
    then ok (HeadResult.Reject BAD_REQUEST)
    else
      let rl ← request_line buf 0#usize j
      match rl with
      | ReqLine.Bad s => ok (HeadResult.Reject s)
      | ReqLine.Ok method target minor =>
        let a := Array.repeat 16#usize NO_HEADER
        let i1 ← j + 2#usize
        let i2 ← lift (UScalar.cast .U64 lim.max_body)
        let f ←
          fields buf n i1
            {
              headers := a,
              count := 0#usize,
              host := false,
              has_cl := false,
              cl := 0#u64,
              te := false
            } minor i2
        match f with
        | Fielded.More =>
          if full
          then ok (HeadResult.Reject HEADERS_TOO_LARGE)
          else ok HeadResult.Incomplete
        | Fielded.Bad s => ok (HeadResult.Reject s)
        | Fielded.Done f1 len =>
          if minor = 1#u8
          then
            if f1.host
            then
              if f1.te
              then
                ok (HeadResult.Done
                  {
                    method,
                    target,
                    minor,
                    headers := f1.headers,
                    count := f1.count,
                    len,
                    framing := Framing.Chunked
                  })
              else
                if f1.has_cl
                then
                  ok (HeadResult.Done
                    {
                      method,
                      target,
                      minor,
                      headers := f1.headers,
                      count := f1.count,
                      len,
                      framing := (Framing.Length f1.cl)
                    })
                else
                  ok (HeadResult.Done
                    {
                      method,
                      target,
                      minor,
                      headers := f1.headers,
                      count := f1.count,
                      len,
                      framing := Framing.Empty
                    })
            else ok (HeadResult.Reject BAD_REQUEST)
          else
            if f1.te
            then
              ok (HeadResult.Done
                {
                  method,
                  target,
                  minor,
                  headers := f1.headers,
                  count := f1.count,
                  len,
                  framing := Framing.Chunked
                })
            else
              if f1.has_cl
              then
                ok (HeadResult.Done
                  {
                    method,
                    target,
                    minor,
                    headers := f1.headers,
                    count := f1.count,
                    len,
