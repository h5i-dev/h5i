/-- [h5i_app_embedded::store_core::parse_header]:
    Source: 'crates/h5i-app-embedded/src/store_core.rs', lines 305:0-333:1
    Visibility: public -/
def store_core.parse_header
  (buf : Slice Std.U8) (off : Std.U32) (g : store_core.FlashGeometry) :
  Result store_core.HeaderParse
  := do
  let i := Slice.len buf
  if i < store_core.HDR
  then ok store_core.HeaderParse.Torn
  else
    let b ← store_core.all_erased buf 0#usize store_core.HDR
    if b
    then ok store_core.HeaderParse.Erased
    else
      let o ← store_core.get_u32_le buf 0#usize
      match o with
      | none => ok store_core.HeaderParse.Torn
      | some magic =>
        let o1 ← store_core.get_u32_le buf 4#usize
        match o1 with
        | none => ok store_core.HeaderParse.Torn
        | some seq =>
          let o2 ← store_core.get_u16_le buf 8#usize
          match o2 with
          | none => ok store_core.HeaderParse.Torn
          | some version =>
            let o3 ← store_core.get_u16_le buf 10#usize
            match o3 with
            | none => ok store_core.HeaderParse.Torn
            | some len_u16 =>
              let len ← lift (UScalar.cast .U32 len_u16)
              let a ← store_core.align g.write_size g.read_size
              let o4 ← store_core.record_len len a
              match o4 with
              | none => ok store_core.HeaderParse.Torn
              | some rl =>
                if magic != store_core.MAGIC
                then ok store_core.HeaderParse.Torn
                else
                  if rl > g.buf_cap
                  then ok store_core.HeaderParse.Torn
                  else
                    if off > g.region
                    then ok store_core.HeaderParse.Torn
                    else
                      let i1 ← g.region - off
                      if rl > i1
                      then ok store_core.HeaderParse.Torn
                      else
                        ok (store_core.HeaderParse.Ok
                          { seq, version, payload_len := len, record_len := rl
                          })

/-- [h5i_app_embedded::store_core::validate_record_crc]:
    Source: 'crates/h5i-app-embedded/src/store_core.rs', lines 336:0-344:1
    Visibility: public -/
def store_core.validate_record_crc
  (buf : Slice Std.U8) (payload_len : Std.U32) : Result Bool := do
  let o ← store_core.get_u32_le buf 12#usize
  match o with
  | none => ok false
  | some stored =>
    let i ← lift (UScalar.cast .Usize payload_len)
    let o1 ← store_core.record_crc buf i
    match o1 with
    | none => ok false
    | some computed => ok (stored = computed)

