def store_core.scan_init
  (g : store_core.FlashGeometry) :
  Result (store_core.ScanState × store_core.ScanAction)
  := do
  let b ← store_core.layout_ok g
  if b
  then
    let i ← store_core.region_start g 0#u32
    ok
      ({
         region := 0#u32,
         off := 0#u32,
         best := none,
         end0 := 0#u32,
         torn0 := false,
         end1 := 0#u32,
         torn1 := false,
         phase := store_core.ScanPhase.ReadHeader
       }, store_core.ScanAction.Read i 0#u32 store_core.HDR_U32)
  else
    ok
      ({
         region := 0#u32,
         off := 0#u32,
         best := none,
         end0 := 0#u32,
         torn0 := false,
         end1 := 0#u32,
         torn1 := false,
         phase := store_core.ScanPhase.Done
       }, store_core.ScanAction.InvalidLayout)

/-- [h5i_app_embedded::store_core::finish_region]:
    Source: 'crates/h5i-app-embedded/src/store_core.rs', lines 491:0-516:1 -/
def store_core.finish_region
  (g : store_core.FlashGeometry) (st : store_core.ScanState) (torn : Bool) :
  Result (store_core.ScanState × store_core.ScanAction)
  := do
  if st.region = 0#u32
  then
    let i ← store_core.region_start g 1#u32
    ok
      ({
         st
           with
           region := 1#u32,
           off := 0#u32,
           end0 := st.off,
           torn0 := torn,
           phase := store_core.ScanPhase.ReadHeader
       }, store_core.ScanAction.Read i 0#u32 store_core.HDR_U32)
  else
    match st.best with
    | none =>
      ok
        ({
           st
             with
             end1 := st.off, torn1 := torn, phase := store_core.ScanPhase.Done
         }, store_core.ScanAction.Done
        { region := 1#u32, append := none, seq := 0#u32 } none 0#u32)
    | some b =>
      let i ← store_core.region_start g b.region
      let addr ← i + b.off
      ok
        ({
           st
             with
             end1 := st.off,
             torn1 := torn,
             phase := store_core.ScanPhase.ReloadBest
         }, store_core.ScanAction.Read addr 0#u32 b.record_len)

/-- [h5i_app_embedded::store_core::accept_valid_record]:
    Source: 'crates/h5i-app-embedded/src/store_core.rs', lines 519:0-546:1 -/
def store_core.accept_valid_record
  (g : store_core.FlashGeometry) (st : store_core.ScanState)
  (hdr : store_core.HeaderInfo) :
  Result (store_core.ScanState × store_core.ScanAction)
  := do
  let (o, hdr1, replace) ←
    match st.best with
    | none => ok (none, hdr, true)
    | some prev =>
      do
      let replace1 ← store_core.seq_newer hdr.seq prev.seq
      ok (st.best, hdr, replace1)
  let (o1, hdr2) ←
    if replace
    then
      ok (some
        ({
           seq := hdr1.seq,
           region := st.region,
           off := st.off,
           version := hdr1.version,
           payload_len := hdr1.payload_len,
           record_len := hdr1.record_len
         } : store_core.BestRecord), hdr1)
    else ok (o, hdr1)
  let i ← st.off + hdr2.record_len
  if i <= g.region
  then
    let i1 ← g.region - i
    if store_core.HDR_U32 <= i1
    then
      let i2 ← store_core.region_start g st.region
      let addr ← i2 + i
      ok
        ({
           st
             with
             off := i, best := o1, phase := store_core.ScanPhase.ReadHeader
         }, store_core.ScanAction.Read addr 0#u32 store_core.HDR_U32)
    else store_core.finish_region g { st with off := i, best := o1 } false
  else store_core.finish_region g { st with off := i, best := o1 } false

/-- [h5i_app_embedded::store_core::scan_result_pos]:
    Source: 'crates/h5i-app-embedded/src/store_core.rs', lines 549:0-554:1
    Visibility: public -/
def store_core.scan_result_pos
  (st : store_core.ScanState) (b : store_core.BestRecord) :
  Result store_core.Pos
  := do
  let («end», torn) ←
    if b.region = 0#u32
    then ok (st.end0, st.torn0)
    else ok (st.end1, st.torn1)
  let i ← b.off + b.record_len
  if torn
  then ok { region := b.region, append := none, seq := b.seq }
  else
    if i = «end»
    then ok { region := b.region, append := (some «end»), seq := b.seq }
    else ok { region := b.region, append := none, seq := b.seq }

/-- [h5i_app_embedded::store_core::scan_step]:
    Source: 'crates/h5i-app-embedded/src/store_core.rs', lines 558:0-619:1
    Visibility: public -/
def store_core.scan_step
  (g : store_core.FlashGeometry) (st : store_core.ScanState)
  (buf : Slice Std.U8) :
  Result (store_core.ScanState × store_core.ScanAction)
  := do
  let b ← store_core.layout_ok g
  if b
  then
    match st.phase with
    | store_core.ScanPhase.ReadHeader =>
      let hp ← store_core.parse_header buf st.off g
      match hp with
      | store_core.HeaderParse.Erased => store_core.finish_region g st false
      | store_core.HeaderParse.Torn => store_core.finish_region g st true
      | store_core.HeaderParse.Ok hdr =>
        if hdr.record_len > store_core.HDR_U32
        then
          let i ← store_core.region_start g st.region
          let i1 ← i + st.off
          let addr ← i1 + store_core.HDR_U32
          let body_len ← hdr.record_len - store_core.HDR_U32
          ok ({ st with phase := (store_core.ScanPhase.ReadBody hdr) },
            store_core.ScanAction.Read addr store_core.HDR_U32 body_len)
        else
          let b1 ← store_core.validate_record_crc buf hdr.payload_len
          if b1
          then store_core.accept_valid_record g st hdr
          else store_core.finish_region g st true
    | store_core.ScanPhase.ReadBody hdr =>
      let b1 ← store_core.validate_record_crc buf hdr.payload_len
      if b1
      then store_core.accept_valid_record g st hdr
      else store_core.finish_region g st true
    | store_core.ScanPhase.ReloadBest =>
      match st.best with
      | none =>
        ok ({ st with phase := store_core.ScanPhase.Done },
          store_core.ScanAction.Done
          { region := 1#u32, append := none, seq := 0#u32 } none 0#u32)
      | some b1 =>
        let pos ←
          store_core.scan_result_pos
            { st with phase := store_core.ScanPhase.Done } b1
        let b2 ← store_core.validate_record_crc buf b1.payload_len
        if b2
        then
          ok ({ st with phase := store_core.ScanPhase.Done },
            store_core.ScanAction.Done pos (some b1.version) b1.payload_len)
        else
          ok ({ st with phase := store_core.ScanPhase.Done },
            store_core.ScanAction.Done pos none 0#u32)
    | store_core.ScanPhase.Done =>
      match st.best with
      | none =>
        ok (st, store_core.ScanAction.Done
          { region := 1#u32, append := none, seq := 0#u32 } none 0#u32)
      | some b1 =>
        let pos ← store_core.scan_result_pos st b1
        ok (st, store_core.ScanAction.Done pos none 0#u32)
  else
    ok ({ st with phase := store_core.ScanPhase.Done },
      store_core.ScanAction.InvalidLayout)

