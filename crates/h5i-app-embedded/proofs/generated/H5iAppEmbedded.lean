@[discriminant isize]
inductive store_core.SavePlan where
| TooLarge : store_core.SavePlan
| WriteOnly :
  Std.U32 →
  Std.U32 →
  Std.U32 →
  Std.U32 →
  Std.U32 →
  store_core.Pos →
  store_core.SavePlan
| EraseThenWrite :
  Std.U32 →
  Std.U32 →
  Std.U32 →
